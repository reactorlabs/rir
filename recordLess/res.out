> reversecomplement_2 <- function(args) {
+     f <- file(args[[1]], "r")
+     lines <- readLines(f)
+     for (i in 1:length(lines)) {
+         codes <- strsplit(lines[[i]], split="")[[1]]
+         if (codes[[1]] == '>')
+             cat(lines[[i]], "\n", sep="")
+         else {
+             cat(paste(comp_map[codes], collapse=""), "\n",
+                 sep="")
+         }
+     }
+     close(f)
+ }
> 
> rir.compile(reversecomplement_2)
function (args) 
{
    f <- file(args[[1]], "r")
    lines <- readLines(f)
    for (i in 1:length(lines)) {
        codes <- strsplit(lines[[i]], split = "")[[1]]
        if (codes[[1]] == ">") 
            cat(lines[[i]], "\n", sep = "")
        else {
            cat(paste(comp_map[codes], collapse = ""), "\n", 
                sep = "")
        }
    }
    close(f)
}
